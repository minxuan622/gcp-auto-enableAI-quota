# ──────────────────────────────────────────────
# GCP Claude Manager 環境設定
# 複製此檔為 .env 後依需求修改
# ──────────────────────────────────────────────

# config.json 路徑（相對於專案根目錄）
CONFIG_PATH=config.json

# 瀏覽器設定
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=500

# 瀏覽器模式（CLI 的 --browser 可臨時覆蓋）
#   chromium = Playwright 內建 Chromium，登入狀態存於 BROWSER_STATE_DIR（預設）
#   attach   = 接管另外啟動的獨立 Chrome（非日常使用的 Chrome）；需以 remote debugging + 獨立設定檔啟動，見 README
BROWSER_MODE=chromium
# attach 模式連線位址（對應 Chrome 啟動參數 --remote-debugging-port）
BROWSER_CDP_URL=http://127.0.0.1:9222

# 瀏覽器登入狀態儲存目錄（第一次登入後自動建立）
BROWSER_STATE_DIR=.browser_state

# 預設 Region（可在互動選單中覆蓋）
DEFAULT_REGION=us-east5

# EULA 送出被 Marketplace 拒絕（"An error occurred while submitting the request"）時，
# 每次重試前的等待秒數，逐次拉長；項目數 = 重試次數
SUBMIT_RETRY_WAITS=30,60,120
